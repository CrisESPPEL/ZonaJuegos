<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta compartida: portada real cuando existe y símbolo del género como reserva. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contenedorTarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/fondo_tarjeta"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Se superponen imagen y símbolo para no ocupar espacio extra en la lista. -->
    <FrameLayout
        android:layout_width="76dp"
        android:layout_height="104dp"
        android:layout_marginEnd="12dp">
        <ImageView
            android:id="@+id/ivPortadaItem"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Portada del videojuego"
            android:scaleType="centerCrop" />
        <TextView
            android:id="@+id/tvGeneroIcono"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#EEEAFE"
            android:gravity="center"
            android:text="🎮"
            android:textSize="30sp" />
    </FrameLayout>

    <!-- Nombre, clasificación y datos de juego se mantienen legibles en pantallas estrechas. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvTituloItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Título del videojuego"
            android:textColor="#252841"
            android:textSize="17sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvDescripcionItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Género · Plataforma"
            android:textColor="#5E6378"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tvMetaItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="#73788D"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
