<?xml version="1.0" encoding="utf-8"?>
<!-- Una fila del catálogo remoto, con miniatura, nombre, género y plataforma. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/fondo_tarjeta"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/ivCatalogoPortada"
        android:layout_width="112dp"
        android:layout_height="72dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="Miniatura del juego"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvCatalogoTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#20233A"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvCatalogoDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#62677C"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
