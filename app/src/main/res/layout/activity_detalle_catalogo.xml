<?xml version="1.0" encoding="utf-8"?>
<!-- Detalle descargable y cacheable; el botón de incorporación crea una fila propia en Room. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/btnVolverDetalleCatalogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹ Catálogo" />

        <ProgressBar
            android:id="@+id/pbDetalleCatalogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivDetalleCatalogo"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="8dp"
            android:contentDescription="Imagen del juego"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvTituloDetalleCatalogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#20233A"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGeneroDetalleCatalogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp" />
        <TextView
            android:id="@+id/tvPlataformaDetalleCatalogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp" />
        <TextView
            android:id="@+id/tvDescripcionDetalleCatalogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/tvDesarrolladorDetalleCatalogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
        <TextView
            android:id="@+id/tvLanzamientoDetalleCatalogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
        <TextView
            android:id="@+id/tvAvisoDetalleCatalogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#3478F6" />

        <Button
            android:id="@+id/btnAnadirBiblioteca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Añadir a mi colección" />
        <Button
            android:id="@+id/btnFichaFreeToGame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Abrir página del juego" />
    </LinearLayout>
</ScrollView>
